rules_version = '2';

// Executive Frame Client Hub: rules for the named database `clienthub`.
// Deployed through the "database": "clienthub" entry in firebase.json.
//
// Principles
// 1. No client or staff account writes directly. Every write goes through
//    Cloud Functions using the Admin SDK, which bypasses these rules.
// 2. A client reads only documents that carry their own uid.
// 3. Clinical content (responses, scores, drafts, formulations, client type)
//    is readable by the practitioner role only. The admin role can operate
//    the system (measure library, config) without reading clinical content
//    and without learning who the clients are: being a psychologist's
//    client is health information, so activation codes (which carry a name
//    and an email) and the audit log are practitioner only. An admin
//    account is handed a list of codes without names by the
//    listActivationCodes function.
// 4. Draft scoring lives in `scoring`, which no client can read. Released
//    content is copied into `results` and `formulations` by releaseResults,
//    and those documents are readable only once releasedAt is set.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isPractitioner() {
      return role() == 'practitioner';
    }

    function isStaff() {
      return role() == 'practitioner' || role() == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isReleased() {
      return resource.data.get('releasedAt', null) != null;
    }

    // ---------- client records ----------

    // Profile, consent record, client type, journey stage, retention date.
    match /clients/{uid} {
      allow read: if isSelf(uid) || isPractitioner();
      allow write: if false;
    }

    // Intake answers given at activation.
    match /intakeResponses/{uid} {
      allow read: if isSelf(uid) || isPractitioner();
      allow write: if false;
    }

    // Assignment status: uid, measureId, status, order, assignedAt,
    // completedAt, and the client's own answers while a questionnaire is in
    // progress (so they can stop and resume). submitMeasure moves the
    // answers to `scoring` and clears them here. Scores are never stored here.
    match /assignments/{assignmentId} {
      allow read: if ownsExisting() || isPractitioner();
      allow write: if false;
    }

    // Responses, draft scores and draft report. Practitioner only.
    match /scoring/{assignmentId} {
      allow read: if isPractitioner();
      allow write: if false;
    }

    // Released results, 1 document per client keyed by uid, written only by
    // releaseResults. Read by document id, so no query is needed.
    match /results/{uid} {
      allow read: if (isSelf(uid) && isReleased()) || isPractitioner();
      allow write: if false;
    }

    // Formulation drafts. Practitioner only.
    match /formulationDrafts/{uid} {
      allow read: if isPractitioner();
      allow write: if false;
    }

    // Released formulation, keyed by client uid.
    match /formulations/{uid} {
      allow read: if (isSelf(uid) && isReleased()) || isPractitioner();
      allow write: if false;
    }

    // The client's responses to their released formulation (fits, partly,
    // does not fit, comment). Written only by respondToFormulation.
    match /formulationResponses/{uid} {
      allow read: if isSelf(uid) || isPractitioner();
      allow write: if false;
    }

    // Access and correction requests under the Health Information Privacy
    // Code 2020, rules 6 and 7.
    match /requests/{requestId} {
      allow read: if ownsExisting() || isPractitioner();
      allow write: if false;
    }

    // Check in schedules Sarah sets. The client reads their own so Home can
    // show the next date; the questionnaire itself arrives as an assignment.
    match /schedules/{scheduleId} {
      allow read: if ownsExisting() || isPractitioner();
      allow write: if false;
    }

    // Progress read from Splose by runSploseSync: next appointment, sessions
    // attended, form status, last updated. Dates, statuses and counts only.
    match /sploseProgress/{uid} {
      allow read: if isSelf(uid) || isPractitioner();
      allow write: if false;
    }

    // ---------- operational records ----------

    // Activation codes. Stored by hashed code; never readable by clients.
    // A code carries the client's name and may carry their email, so only
    // the practitioner reads them. Admin uses listActivationCodes.
    match /activationCodes/{codeId} {
      allow read: if isPractitioner();
      allow write: if false;
    }

    // Measure library, with scoring rules, bands and flag thresholds. Staff
    // only. A client is handed the questions and answer options of the
    // questionnaires assigned to them by the myQuestionnaires function, so
    // no client can read how an answer is scored.
    match /measures/{measureId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Editable configuration (intake questionnaire, client type copy).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Audit trail of practitioner actions. Written by functions only.
    // Practitioner only: entries name client uids, and entries written
    // before 11 November 2026 for issued codes carry the client's name.
    match /auditLog/{entryId} {
      allow read: if isPractitioner();
      allow write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
