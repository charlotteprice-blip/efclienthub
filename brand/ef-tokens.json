        "weight": 300
      },
      "body": {
        "size": 18,
        "mobile": 17,
        "lineHeight": 1.6,
        "weight": 300
      },
      "ui": {
        "size": 16,
        "lineHeight": 1.4,
        "weight": 400
      },
      "uiStrong": {
        "size": 16,
        "lineHeight": 1.4,
        "weight": 500
      },
      "caption": {
        "size": 14,
        "lineHeight": 1.5,
        "weight": 300
      }
    }
