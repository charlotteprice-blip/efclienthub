  "logo": {
    "mark": {
      "grid": 100,
      "loop": {
        "type": "open circle",
        "centre": [
          50,
          50
        ],
        "radius": 40,
        "startAngle": 118,
        "endAngle": 142,
        "sweep": 336,
        "direction": "anticlockwise on screen; the end sits above the start",
        "path": "M31.22 85.32 A40 40 0 1 0 18.48 74.63"
      },
      "triangle": "M44 34.3 Q50 24.3 56 34.3 L69 57.3 Q74 66.3 64 66.3 L36 66.3 Q26 66.3 31 57.3 Z",
      "strokes": {
        "standard": 5,
        "display": 2.4,
        "favicon": 8
      },
      "use": {
        "display": "240 px and above",
        "standard": "24 px to 240 px",
        "favicon": "16 px to 24 px"
      }
    },
    "wordmark": {
      "text": "Executive Frame",
      "family": "Figtree",
      "weight": 500,
      "letterSpacing": "-0.01em",
      "case": "sentence",
      "capHeight": 0.7
    },
    "lockup": {
      "markBox": "1.5 × wordmark font size",
      "gap": "0.5 × font size",
      "alignment": "mark centred on the middle of the cap height",
      "widthAt100px": 935.6
    },
    "stacked": {
      "markBox": "2.2 × font size",
      "line": "Human first. Then performance., Figtree Regular at 0.30 × font size, 0.95 × font size below the wordmark baseline",
      "alignment": "centred"
    },
    "clearSpace": "0.4 × the mark box on every side",
    "minimum": {
      "markPx": 16,
      "markMm": 4,
      "lockupPx": 140,
      "lockupMm": 35,
      "stackedPx": 180
    },
    "colours": "slate on sky, warm white and white; warm white on navy and slate. Never any other colour"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999
  },
  "motion": {
    "durationMs": 180,
    "easing": "ease-out",
    "markDrawOnMs": 1200,
    "reducedMotion": "show the finished mark, skip transitions"
  },
  "language": {
    "english": "New Zealand",
    "dashes": "none, use commas or full stops",
    "exclamation": "none",
    "headings": "sentence case",
    "audiences": "pathways in public copy; arms is internal only",
    "place": "New Zealand, not Aotearoa, in professional material",
    "loop": "C3 Loop: Centre, Clarify, Choose, then return"
  }
}