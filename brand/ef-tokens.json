{
  "brand": "Executive Frame",
  "version": "1.1",
  "date": "2026-11-11",
  "palette": {
    "sky": {
      "hex": "#CFDAE8",
      "role": "The light ground. Provisional value; lighter candidates #DCE4EE, #D6E6F2, #E4EDF5"
    },
    "slate": {
      "hex": "#3E5680",
      "role": "All type and the logo on light grounds"
    },
    "navy": {
      "hex": "#2E4062",
      "role": "The dark ground of the inverted theme"
    },
    "warmWhite": {
      "hex": "#F5F3EE",
      "role": "Panels, forms and reading sections on light; all type and the logo on navy"
    }
  },
  "themes": {
    "light": {
      "ground": "#CFDAE8",
      "ink": "#3E5680",
      "panel": "#F5F3EE",
      "onPanel": "#3E5680",
      "readingGround": "#F5F3EE",
      "onReading": "#3E5680",
      "primary": "#3E5680",
      "onPrimary": "#F5F3EE",
      "hairline": "rgba(62, 86, 128, 0.25)",
      "underline": "rgba(62, 86, 128, 0.40)",
      "focus": "#3E5680"
    },
    "inverted": {
      "ground": "#2E4062",
      "ink": "#F5F3EE",
      "panel": "#CFDAE8",
      "onPanel": "#2E4062",
      "readingGround": "#3E5680",
      "onReading": "#F5F3EE",
      "primary": "#CFDAE8",
      "onPrimary": "#2E4062",
      "hairline": "rgba(245, 243, 238, 0.25)",
      "underline": "rgba(245, 243, 238, 0.45)",
      "focus": "#F5F3EE"
    }
  },
  "application": {
    "note": "Interface only, never on brand surfaces. Light values sit on warm white or their tint; dark values on navy",
    "error": {
      "light": "#8A3F34",
      "tint": "#F6E3DF",
      "dark": "#F2B8AD"
    },
    "success": {
      "light": "#285E44",
      "tint": "#E3EFE8",
      "dark": "#A9D9BF"
    },
    "warning": {
      "light": "#73540F",
      "tint": "#F7EDD4",
      "dark": "#EBCB82"
    },
    "info": {
      "light": "#3E5680",
      "tint": "#E6ECF4",
      "dark": "#CFDAE8"
    }
  },
  "contrast": {
    "slateOnSky": 5.2,
    "slateOnWarmWhite": 6.7,
    "warmWhiteOnNavy": 9.3,
    "navyOnSky": 7.3,
    "warmWhiteOnSlate": 6.7,
    "slateOnWhite": 7.4,
    "note": "Every text pair in both themes is 5.2 to 1 or better. There is no muted text colour: slate at reduced opacity falls below 4.5 to 1 on sky, so captions are slate at the light weight instead"
  },
  "type": {
    "family": "Figtree",
    "source": "Google Fonts",
    "weights": [
      300,
      400,
      500
    ],
    "fallback": "system-ui, sans-serif",
    "case": "sentence everywhere, no capitals, no bold above 500, no italics for emphasis",
    "scale": {
      "display": {
        "size": 96,
        "mobile": 56,
        "lineHeight": 0.98,
        "weight": 400,
        "tracking": "-0.03em"
      },
      "h1": {
        "size": 64,
        "mobile": 44,
        "lineHeight": 1.02,
        "weight": 400,
        "tracking": "-0.03em"
      },
      "h2": {
        "size": 48,
        "mobile": 36,
        "lineHeight": 1.05,
        "weight": 400,
        "tracking": "-0.02em"
      },
      "h3": {
        "size": 40,
